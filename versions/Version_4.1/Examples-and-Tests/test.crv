?{ =================================================
   Corvus Feature Showcase:
   Math, Scope Isolation, Recursion, and Iteration
   ================================================= }

mk func factorial(n) [
    if (n <= 1) [
        givout 1
    ]
    givout n * factorial(n - 1)
]

mk func is_even(num) [
    if (num % 2 == 0) [
        givout true
    ]
    givout fal
]

log("--- Starting Corvus Test Suite ---")

set const; MAX_LIMIT = 5
log("Calculating factorials up to:", MAX_LIMIT)

set int; current = 1
while (current <= MAX_LIMIT) [
    set int; fact = factorial(current)

    if (is_even(fact)) [
        log("Value:", current, "Factorial:", fact, "[Even]")
    ] else [
        log("Value:", current, "Factorial:", fact, "[Odd]")
    ]

    current = current + 1
]

log("--- Testing Native Collections ---")

set lis; items = {10, 20, 30}
set tup; pair = ([100, 200])

log("List contents:", items)
log("Tuple pair:", pair)

for (elem in items) [
    set int; amplified = elem * 2
    log("Original:", elem, "-> Amplified:", amplified)
]

log("--- Test Suite Completed Successfully ---")
