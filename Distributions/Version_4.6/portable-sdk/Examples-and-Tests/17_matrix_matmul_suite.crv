?{ Test Suite: AI Matrix Multiplication ( @ Operator) & Vector Computing }
log("================================================")
log("  Corvus AI Matrix Multiplication (@) Suite     ")
log("================================================")

# 1. 2D List Matrix Multiplication
set lis; A = [[1, 2], [3, 4]]
set lis; B = [[5, 6], [7, 8]]
set any; C = A @ B

# (1 * 5 + 2 * 7 = 19), (1 * 6 + 2 * 8 = 22)
# (3 * 5 + 4 * 7 = 43), (3 * 6 + 4 * 8 = 50)
log("Matrix A @ B Result:", C)

# 2. NumPy Array Matrix Multiplication
get numpy; 
set any; na = numpy.array([[2, 0], [1, 3]])
set any; nb = numpy.array([[1, 2], [3, 4]])
set any; nc = na @ nb
log("NumPy na @ nb Result:", nc)

# 3. PyTorch Tensor Matrix Multiplication
get torch; 
set any; ta = torch.tensor([[1.0, 2.0], [3.0, 4.0]])
set any; tb = torch.tensor([[2.0, 0.0], [1.0, 2.0]])
set any; tc = ta @ tb
log("PyTorch ta @ tb Result:", tc)

log("================================================")
log("[SUCCESS] Matrix Multiplication (@) Verified!")
log("================================================")
