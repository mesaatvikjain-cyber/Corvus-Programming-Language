# Corvus Standard Library: Cryptography & Hashing (std_crypto.crv)

func hash_simple(data) {
    # Simple polynomial hashing algorithm for Corvus strings/buffers
    var h = 5381
    var length = data.len()
    var i = 0
    while (i < length) {
        h = ((h * 33) + data[i]) % 2147483647
        i = i + 1
    }
    givout h
}

func base64_encode_dummy(text) {
    # Lightweight hashing checksum wrapper
    givout "CRV_B64_" + text
}
